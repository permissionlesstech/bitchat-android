    <string name="location_services_required">Locatiediensten vereist</string>
    <string name="privacy_first">Privacy eerst</string>
    <string name="location_explanation">bitchat volgt NIET uw locatie.\n\nLocatiediensten zijn vereist voor Bluetooth-scanning en voor de geohash-chatfunctie.</string>
    <string name="location_needs_for">bitchat heeft locatiediensten nodig voor:</string>
    <string name="location_needs_bullets">• Bluetooth-apparaat scanning\n• Ontdekken van gebruikers in de buurt op meshnetwerk\n• Geohash-chatfunctie\n• Geen tracking of locatieverzameling</string>
    <string name="open_location_settings">Locatie-instellingen openen</string>
    <string name="check_again">Opnieuw controleren</string>
    <string name="location_services_unavailable">Locatiediensten niet beschikbaar</string>
    <string name="location_unavailable_explanation">Locatiediensten zijn niet beschikbaar op dit apparaat. Dit is ongebruikelijk omdat locatiediensten standaard zijn op Android-apparaten.\n\nbitchat heeft locatiediensten nodig om Bluetooth-scanning goed te laten werken (Android-vereiste). Zonder dit kan de app geen gebruikers in de buurt ontdekken.</string>
    <string name="checking_location_services">Locatiediensten controleren…</string>
    <string name="bluetooth_needs_for">bitchat heeft Bluetooth nodig om:</string>
    <string name="bluetooth_needs_bullets">• Gebruikers in de buurt te ontdekken\n• Meshnetwerkverbindingen te maken\n• Berichten te verzenden en ontvangen\n• Te werken zonder internet of servers</string>
    <string name="enable_bluetooth">Bluetooth inschakelen</string>
    <string name="bluetooth_not_supported">Bluetooth niet ondersteund</string>
    <string name="bluetooth_unsupported_explanation">Dit apparaat ondersteunt geen Bluetooth Low Energy (BLE), wat vereist is om bitchat te laten functioneren.\n\nbitchat heeft BLE nodig om meshnetwerken te maken en te communiceren met apparaten in de buurt zonder internet.</string>
    <string name="checking_bluetooth_status">Bluetooth-status controleren…</string>
    <string name="battery_optimization_detected_title">batterijoptimalisatie gedetecteerd</string>
    <string name="battery_optimization_enabled_title">Batterijoptimalisatie ingeschakeld</string>
    <string name="battery_optimization_explanation_short">bitchat moet op de achtergrond draaien om meshverbindingen te onderhouden. batterijoptimalisatie kan deze verbindingen onderbreken.</string>
    <string name="benefits_of_disabling">Voordelen van uitschakelen</string>
