    <string name="about_offline_mesh_title">Chat Mesh hors‑ligne</string>
    <string name="about_offline_mesh_desc">Communique directement via Bluetooth LE sans internet ni serveurs. Les messages sont relayés par les appareils proches pour étendre la portée.</string>
