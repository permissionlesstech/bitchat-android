    <string name="about_offline_mesh_title">Trò chuyện Mesh ngoại tuyến</string>
    <string name="about_offline_mesh_desc">Liên lạc trực tiếp qua Bluetooth LE mà không cần Internet hoặc máy chủ. Tin nhắn được chuyển tiếp qua các thiết bị gần để mở rộng phạm vi.</string>
    <string name="about_online_geohash_title">Kênh Geohash trực tuyến</string>
    <string name="about_online_geohash_desc">Kết nối với những người trong khu vực của bạn qua các kênh dựa trên geohash. Mở rộng mesh qua các relay Internet công cộng.</string>
    <string name="about_e2e_title">Mã hóa đầu cuối</string>
    <string name="about_e2e_desc">Tin nhắn riêng được mã hóa. Tin nhắn kênh là công khai.</string>
