    <string name="location_services_required">Serviços de localização necessários</string>
    <string name="privacy_first">Privacidade primeiro</string>
    <string name="location_explanation">O bitchat NÃO rastreia a sua localização.\n\nOs serviços de localização são necessários para a digitalização Bluetooth e a funcionalidade de chat geohash.</string>
    <string name="location_needs_for">O bitchat precisa de serviços de localização para:</string>
    <string name="location_needs_bullets">• Digitalização de dispositivos Bluetooth\n• Descobrir utilizadores próximos na rede mesh\n• Funcionalidade de chat geohash\n• Sem rastreamento ou recolha de localização</string>
    <string name="open_location_settings">Abrir definições de localização</string>
    <string name="check_again">Verificar novamente</string>
    <string name="location_services_unavailable">Serviços de localização indisponíveis</string>
    <string name="location_unavailable_explanation">Os serviços de localização não estão disponíveis neste dispositivo. Isto é incomum, uma vez que os serviços de localização são padrão em dispositivos Android.\n\nO bitchat requer serviços de localização para o funcionamento adequado da digitalização Bluetooth (requisito do Android). Sem isso, a aplicação não pode descobrir utilizadores próximos.</string>
    <string name="checking_location_services">A verificar serviços de localização…</string>
    <string name="bluetooth_required">Bluetooth necessário</string>
    <string name="bluetooth_needs_for">O bitchat precisa de Bluetooth para:</string>
    <string name="bluetooth_needs_bullets">• Descobrir utilizadores próximos\n• Criar conexões de rede mesh\n• Enviar e receber mensagens\n• Funcionar sem internet ou servidores</string>
    <string name="enable_bluetooth">Ativar Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth não suportado</string>
    <string name="bluetooth_unsupported_explanation">Este dispositivo não suporta Bluetooth Low Energy (BLE), que é necessário para o bitchat funcionar.\n\nO BLE é necessário para criar redes mesh e comunicar com dispositivos próximos sem internet.</string>
