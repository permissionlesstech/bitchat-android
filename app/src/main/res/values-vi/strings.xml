    <string name="enable_bluetooth">Bật Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth không được hỗ trợ</string>
    <string name="bluetooth_unsupported_explanation">Thiết bị này không hỗ trợ Bluetooth Low Energy (BLE), cần thiết để bitchat hoạt động.\n\nbitchat cần BLE để tạo mạng mesh và liên lạc với thiết bị gần đó mà không cần Internet.</string>
