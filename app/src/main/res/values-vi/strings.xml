    <string name="location_services_unavailable">Dịch vụ vị trí không có sẵn</string>
    <string name="location_unavailable_explanation">Dịch vụ vị trí không có sẵn trên thiết bị này. Điều này bất thường vì dịch vụ vị trí là tiêu chuẩn trên thiết bị Android.\n\nbitchat cần dịch vụ vị trí để quét Bluetooth hoạt động đúng (yêu cầu Android). Không có nó, ứng dụng không thể khám phá người dùng gần đó.</string>
    <string name="checking_location_services">Đang kiểm tra dịch vụ vị trí …</string>
    <string name="bluetooth_required">Yêu cầu Bluetooth</string>
