    <string name="battery_optimization_enabled_title">बैटरी अनुकूलन चालू है</string>
    <string name="battery_optimization_explanation_short">मेष कनेक्शन बनाए रखने के लिए bitchat को पृष्ठभूमि में चलना होता है। बैटरी अनुकूलन इन कनेक्शनों को बाधित कर सकता है।</string>
    <string name="benefits_of_disabling">बंद करने के लाभ</string>
