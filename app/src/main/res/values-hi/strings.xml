    <string name="location_explanation">bitchat आपकी लोकेशन ट्रैक नहीं करती।\n\nBluetooth स्कैनिंग और geohash चैट फीचर के लिए स्थान सेवाएँ आवश्यक हैं।</string>
    <string name="location_needs_for">bitchat को इन कारणों से स्थान सेवाएँ चाहिए:</string>
    <string name="location_needs_bullets">• Bluetooth डिवाइस स्कैनिंग\n• मेष नेटवर्क में पास के उपयोगकर्ताओं की खोज\n• geohash चैट फीचर\n• कोई ट्रैकिंग या लोकेशन संग्रह नहीं</string>
    <string name="open_location_settings">स्थान सेटिंग्स खोलें</string>
    <string name="check_again">फिर से जाँचें</string>
    <string name="location_services_unavailable">स्थान सेवाएँ उपलब्ध नहीं</string>
    <string name="location_unavailable_explanation">इस डिवाइस पर स्थान सेवाएँ उपलब्ध नहीं हैं। यह असामान्य है क्योंकि Android डिवाइसों पर वे सामान्यतः होती हैं।\n\nBluetooth स्कैनिंग (Android आवश्यकता) के ठीक से काम करने के लिए स्थान सेवाएँ जरूरी हैं। इसके बिना ऐप पास के उपयोगकर्ताओं को नहीं ढूँढ़ सकती।</string>
    <string name="checking_location_services">स्थान सेवाएँ जाँची जा रही हैं…</string>
    <string name="bluetooth_required">Bluetooth आवश्यक</string>
    <string name="bluetooth_needs_for">bitchat को Bluetooth की आवश्यकता:</string>
    <string name="bluetooth_needs_bullets">• पास के उपयोगकर्ताओं की खोज\n• मेष कनेक्शन बनाना\n• संदेश भेजना और प्राप्त करना\n• इंटरनेट या सर्वर के बिना काम करना</string>
    <string name="enable_bluetooth">Bluetooth चालू करें</string>
    <string name="bluetooth_not_supported">Bluetooth समर्थित नहीं</string>
    <string name="bluetooth_unsupported_explanation">यह डिवाइस Bluetooth Low Energy (BLE) को सपोर्ट नहीं करता, जो bitchat के लिए आवश्यक है।\n\nइंटरनेट के बिना पास के डिवाइसों के साथ मेष नेटवर्क बनाने और संवाद करने के लिए BLE आवश्यक है।</string>
    <string name="checking_bluetooth_status">Bluetooth स्थिति जाँच रहे हैं…</string>
