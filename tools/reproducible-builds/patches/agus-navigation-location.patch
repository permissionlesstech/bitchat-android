 /// Cancel native CoMaps search and clear cached native results.
 void cancelNativeSearch() {
   try {
     _bindings.comaps_search_cancel();
   } on ArgumentError catch (error) {
     if (kDebugMode) {
       debugPrint('[AgusMap] Native search cancel is unavailable: $error');
     }
   }
 }
 
+/// Send a platform location update to CoMaps for route matching and guidance.
+int updateNavigationLocation({
+  required double latitude,
+  required double longitude,
+  required double horizontalAccuracy,
+  required double timestampSeconds,
+  double bearingDegrees = -1,
+  double speedMetersPerSecond = -1,
+}) {
+  if (!latitude.isFinite ||
+      latitude < -90 ||
+      latitude > 90 ||
+      !longitude.isFinite ||
+      longitude < -180 ||
+      longitude > 180 ||
+      !horizontalAccuracy.isFinite ||
+      horizontalAccuracy < 0 ||
+      !timestampSeconds.isFinite ||
+      timestampSeconds < 0 ||
+      !bearingDegrees.isFinite ||
+      bearingDegrees < -1 ||
+      bearingDegrees >= 360 ||
+      !speedMetersPerSecond.isFinite ||
+      speedMetersPerSecond < -1) {
+    throw ArgumentError('Invalid navigation location');
+  }
+
+  try {
+    return _bindings.comaps_navigation_update_location(
+      latitude,
+      longitude,
+      horizontalAccuracy,
+      timestampSeconds,
+      bearingDegrees,
+      speedMetersPerSecond,
+    );
+  } on ArgumentError catch (error) {
+    if (kDebugMode) {
+      debugPrint('[AgusMap] Navigation location updates are unavailable: $error');
+    }
+    return -1;
+  }
+}
+
 /// Select the native CoMaps router engine.
 int setNavigationRouter(NavigationRouterType routerType) {
   try {
     return _bindings.comaps_navigation_set_router(routerType.index);
   } on ArgumentError catch (error) {
     if (kDebugMode) {
       debugPrint('[AgusMap] Navigation router is unavailable: $error');
     }
     return -1;
   }
 }
