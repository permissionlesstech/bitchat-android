+++ b/src/agus_maps_flutter.cpp
@@ -2322,10 +2322,40 @@
 FFI_PLUGIN_EXPORT void comaps_navigation_clear_route_points(void) {
     agus::navigation::ClearRoutePoints(g_framework.get());
     WakeRenderer();
 }
 
+FFI_PLUGIN_EXPORT int32_t comaps_navigation_update_location(
+    double latitude,
+    double longitude,
+    double horizontalAccuracy,
+    double timestamp,
+    double bearing,
+    double speed) {
+    if (!g_framework) return -1;
+    if (!std::isfinite(latitude) || latitude < -90.0 || latitude > 90.0 ||
+        !std::isfinite(longitude) || longitude < -180.0 || longitude > 180.0 ||
+        !std::isfinite(horizontalAccuracy) || horizontalAccuracy < 0.0 ||
+        !std::isfinite(timestamp) || timestamp < 0.0 ||
+        !std::isfinite(bearing) || bearing < -1.0 || bearing >= 360.0 ||
+        !std::isfinite(speed) || speed < -1.0) {
+        return -2;
+    }
+
+    location::GpsInfo info;
+    info.m_source = location::EUser;
+    info.m_timestamp = timestamp;
+    info.m_latitude = latitude;
+    info.m_longitude = longitude;
+    info.m_horizontalAccuracy = horizontalAccuracy;
+    info.m_bearing = bearing;
+    info.m_speed = speed;
+    g_framework->OnLocationUpdate(info);
+    WakeRenderer();
+    return 1;
+}
+
 FFI_PLUGIN_EXPORT int32_t comaps_navigation_build_route(void) {
     auto const result = agus::navigation::BuildRoute(g_framework.get());
     if (result > 0) WakeRenderer();
     return result;
 }
